PORT=3000
NODE_ENV=development
# Required for deployment; use a PostgreSQL provider's TLS connection string.
DATABASE_URL=
# Production requires at least 12 characters. Never commit the real value.
ADMIN_PIN=
# Keep this secret stable: changing it invalidates every existing CPF hash.
# Production requires 32 characters or more.
CPF_SALT=
# Optional independent key for signed tablet cookies (32+ random characters).
DEVICE_SECRET=
# Set to 1 behind Render's proxy. Local development should use 0.
TRUST_PROXY_HOPS=0
# Enable tablet activation during local testing as well.
REQUIRE_DEVICE=false
# Optional migration only: previous CPF salt, kept private until old hashes migrate.
LEGACY_CPF_SALT=
