{
  "name": "presenca-tesla",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "dev:ui": "vite --config vite.config.js",
    "build": "vite build --config vite.config.js",
    "start": "node server.js",
    "check": "node --check server.js && npm run build",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write client/src server.js server tests scripts",
    "hash:pin": "node scripts/hash-pin.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.8",
    "vite": "^8.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
