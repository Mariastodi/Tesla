{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "functions": {
    "api/admin/overview.js": {
      "includeFiles": "server/migrations/**"
    },
    "api/admin/[...path].js": {
      "includeFiles": "server/migrations/**"
    },
    "api/device/activate.js": {
      "includeFiles": "server/migrations/**"
    },
    "api/[...path].js": {
      "includeFiles": "server/migrations/**"
    }
  }
}
